      "cell_type": "markdown",
      "source": [
        "# Genetic algorithm feature selection"
      ],
      "metadata": {
        "id": "pE4FL1Iofslc"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def score_feature_subset(mask, model_name, score_cache):\n",
        "    \"\"\"Fitness of one feature subset: validation PR-AUC minus a small penalty for using many features.\n",
        "    A light version of the model is trained on the training data and scored on the validation data.\n",
        "    The test set is never used here. Scores are cached so a repeated subset is not retrained.\"\"\"\n",
        "    key = mask.tobytes()\n",
        "    if key in score_cache:\n",
        "        return score_cache[key]\n",
        "\n",
        "    if mask.sum() == 0:\n",
        "        score = -1.0\n",
        "    else:\n",
        "        model = light_models[model_name]().fit(x_train[:, mask], y_train)\n",
        "        val_probs = model.predict_proba(x_val[:, mask])[:, 1]\n",
        "        score = average_precision_score(y_val, val_probs) - ga_penalty * mask.mean()\n",
        "\n",
        "    score_cache[key] = score\n",
        "    return score\n",
        "\n",
        "\n",
        "def pick_parent(population, scores, generator, tournament_size=3):\n",
        "    \"\"\"Tournament selection: draw a few random chromosomes and return the best one.\"\"\"\n",
        "    contenders = generator.choice(len(population), tournament_size, replace=False)\n",
        "    winner = contenders[np.argmax(scores[contenders])]\n",
        "    return population[winner]\n",
        "\n",
        "\n",
        "def make_child(parent_a, parent_b, generator, mutation_rate):\n",
        "    \"\"\"Create a child by uniform crossover (each feature comes from either parent),\n",
        "    then flip a few features at random (mutation). Never returns an empty feature set.\"\"\"\n",
        "    if generator.random() < ga_crossover_prob:\n",
        "        take_from_a = generator.random(len(parent_a)) < 0.5\n",
        "        child = np.where(take_from_a, parent_a, parent_b)\n",
        "    else:\n",
        "        child = parent_a.copy()\n",
        "\n",
        "    flips = generator.random(len(child)) < mutation_rate\n",
        "    child = np.logical_xor(child, flips)\n",
        "\n",
        "    if not child.any():\n",
        "        child[generator.integers(len(child))] = True\n",
        "    return child\n",
        "\n",
        "\n",
        "def run_genetic_algorithm(model_name):\n",
        "    \"\"\"Search for a good subset of features for one model.\n",
        "\n",
        "    A chromosome is a True/False mask over all features. The first chromosome is the full feature set,\n",
        "    so the search starts from 'use everything'. Each generation keeps the best few chromosomes (elitism)\n",
        "    and fills the rest with children of tournament-selected parents.\n",
        "\n",
        "    Returns the best mask and a table with the best score, mean score and feature count per generation.\n",
        "    \"\"\"\n",
        "    generator = np.random.default_rng(seed)\n",
        "    mutation_rate = 1.5 / n_features           # about 1.5 flipped features per child\n",
        "    score_cache = {}\n",
        "\n",
        "    population = generator.random((ga_population, n_features)) < 0.6\n",
        "    population[0, :] = True\n",
        "    history = []\n",
        "\n",
        "    for generation in range(ga_generations + 1):\n",
        "        scores = np.array([score_feature_subset(chromosome, model_name, score_cache) for chromosome in population])\n",
        "        best_index = scores.argmax()\n",
        "        history.append((scores.max(), scores.mean(), population[best_index].sum()))\n",
        "        print(f\"  [{model_name}] generation {generation:02d}: best={scores.max():.4f} \"\n",
        "              f\"mean={scores.mean():.4f} features={population[best_index].sum()}\")\n",
        "\n",
        "        if generation == ga_generations:\n",
        "            break\n",
        "\n",
        "        ranking = np.argsort(-scores)\n",
        "        next_population = [population[i].copy() for i in ranking[:ga_elite_count]]\n",
        "        while len(next_population) < ga_population:\n",
        "            parent_a = pick_parent(population, scores, generator)\n",
        "            parent_b = pick_parent(population, scores, generator)\n",
        "            next_population.append(make_child(parent_a, parent_b, generator, mutation_rate))\n",
        "        population = np.array(next_population)\n",
        "\n",
        "    return population[best_index], np.array(history)\n",
        "\n",
        "\n",
        "ga_masks, ga_history = {}, {}\n",
        "for name in model_names:\n",
        "    print(f\"\\n=== Genetic algorithm for {name} ===\")\n",
        "    start_time = time.time()\n",
        "    ga_masks[name], ga_history[name] = run_genetic_algorithm(name)\n",
        "    print(f\"  kept {ga_masks[name].sum()} of {n_features} features ({time.time() - start_time:.0f}s)\")\n",
        "\n",
        "fig, axes = plt.subplots(1, 3, figsize=(19, 5), gridspec_kw={\"width_ratios\": [1, 1, 1.6]})\n",
        "for name in model_names:\n",
        "    axes[0].plot(ga_history[name][:, 0], marker=\"o\", color=model_colors[name], label=name)\n",
        "axes[0].set(title=\"Best fitness per generation\", xlabel=\"Generation\", ylabel=\"Validation PR-AUC minus penalty\")\n",
        "axes[0].legend(fontsize=8)\n",
        "\n",
        "axes[1].bar(range(4), [ga_masks[name].sum() for name in model_names], color=[model_colors[n] for n in model_names])\n",
        "axes[1].axhline(n_features, color=\"black\", linestyle=\"--\", label=f\"All = {n_features}\")\n",
        "axes[1].set_xticks(range(4))\n",
        "axes[1].set_xticklabels([n.replace(\" \", \"\\n\", 1) for n in model_names], fontsize=8)\n",
        "axes[1].set_title(\"Features kept\")\n",
        "axes[1].legend()\n",
        "\n",
        "selection_table = pd.DataFrame({name: ga_masks[name].astype(int) for name in model_names}, index=feature_names)\n",
        "selection_table = selection_table.loc[selection_table.sum(axis=1).sort_values(ascending=False).index]\n",
        "sns.heatmap(selection_table.head(35), cmap=\"Blues\", cbar=False, linewidths=0.3, ax=axes[2])\n",
        "axes[2].set_title(\"Selected features (35 most often chosen)\")\n",
        "save_and_show(\"genetic_algorithm.png\")\n",
        "\n",
        "for name in model_names:\n",
        "    print(f\"\\n{name} ({ga_masks[name].sum()} features): {', '.join(feature_names[ga_masks[name]])}\")\n",
        "print(\"\\nFeatures chosen by all four models:\", list(selection_table.index[selection_table.sum(axis=1) == 4]))"
      ],
