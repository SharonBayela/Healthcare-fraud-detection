    {
      "cell_type": "markdown",
      "source": [
        "Share of fraudulent claims over time"
      ],
      "metadata": {
        "id": "7IcjB5fow5i3"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Number the weeks from the first service date: days 1-7 = week 1, days 8-14 = week 2, ...\n",
        "days_since_start = (data[\"service_date\"] - data[\"service_date\"].min()).dt.days\n",
        "week_number = days_since_start // 7 + 1\n",
        "\n",
        "weekly_summary = (data.assign(week_number=week_number)\n",
        "                      .groupby(\"week_number\")\n",
        "                      .agg(fraud_rate=(\"is_fraud\", \"mean\"),\n",
        "                           n_claims=(\"is_fraud\", \"size\"),\n",
        "                           n_days=(\"service_date\", \"nunique\")))\n",
        "print(\"Weekly summary (n_days < 7 means a partial week):\")\n",
        "display(weekly_summary)\n",
        "\n",
        "# Plot complete weeks only, so a short last week does not distort the trend\n",
        "complete_weeks = weekly_summary[weekly_summary[\"n_days\"] == 7]\n",
        "\n",
        "plt.figure(figsize=(8, 4.5))\n",
        "plt.plot(complete_weeks.index, complete_weeks[\"fraud_rate\"], marker=\"o\", color=\"#C44E52\")\n",
        "plt.xticks(complete_weeks.index, [f\"Week {w}\" for w in complete_weeks.index])\n",
        "plt.title(\"Weekly share of fraudulent claims\")\n",
        "plt.ylabel(\"Fraud rate\")\n",
        "plt.xlabel(\"\")\n",
        "save_and_show(\"weekly_fraud_rate.png\")"
      ],
