    {
      "cell_type": "markdown",
      "source": [
        "Provider-level fraud label"
      ],
      "metadata": {
        "id": "Snt_SuK1vLdA"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Provider-level fraud label (used only for splitting and plots, never as a model input).\n",
        "# A provider counts as fraudulent if it has at least one fraudulent claim,\n",
        "# unless the providers table already contains its own provider-level label.\n",
        "label_from_claims = claims.groupby(\"provider_id\")[\"is_fraud\"].max()\n",
        "\n",
        "has_provider_labels = (\"is_fraud_provider\" in providers.columns\n",
        "                       and providers[\"is_fraud_provider\"].notna().any())\n",
        "if has_provider_labels:\n",
        "    provider_is_fraud = providers.drop_duplicates(\"provider_id\").set_index(\"provider_id\")[\"is_fraud_provider\"]\n",
        "    provider_is_fraud = provider_is_fraud.reindex(label_from_claims.index).fillna(label_from_claims)\n",
        "else:\n",
        "    print(\"This sample has no provider-level labels, so they are derived from the claim labels.\")\n",
        "    provider_is_fraud = label_from_claims\n",
        "provider_is_fraud = provider_is_fraud.astype(int).rename(\"provider_fraud\")\n",
        "\n",
        "print(\"Providers labelled:\", len(provider_is_fraud))\n",
        "print(\"Fraudulent providers:\", provider_is_fraud.sum())"
      ],
      "metadata": {
        "id": "H7mmxDpmvvfg",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "a88eeb28-5ebe-4028-edb6-33d20a9c55d4"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "This sample has no provider-level labels, so they are derived from the claim labels.\n",
            "Providers labelled: 1500\n",
            "Fraudulent providers: 52\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Merge claims, patients and providers\n"
      ],
      "metadata": {
        "id": "_5IDRFy8vMCQ"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Merge claims + patients + providers.\n",
        "# Drop the provider label columns first so they cannot leak into the features.\n",
        "label_columns = [c for c in [\"is_fraud_provider\", \"fraud_scheme\"] if c in providers.columns]\n",
        "provider_info = (providers.drop(columns=label_columns)\n",
        "                          .drop_duplicates(\"provider_id\")\n",
        "                          .rename(columns={\"region\": \"provider_region\", \"size\": \"provider_size\"}))\n",
        "patient_info = (patients.drop_duplicates(\"patient_id\")\n",
        "                        .rename(columns={\"region\": \"patient_region\"}))\n",
        "\n",
        "data = (claims.merge(patient_info, on=\"patient_id\", how=\"left\")\n",
        "              .merge(provider_info, on=\"provider_id\", how=\"left\"))\n",
        "\n",
        "print(\"Merged table:\", data.shape)\n",
        "display(data.head(3))"
      ],
