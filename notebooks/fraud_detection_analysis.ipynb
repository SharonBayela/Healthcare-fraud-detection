      "cell_type": "markdown",
      "source": [
        "# Precision-recall and calibration plots"
      ],
      "metadata": {
        "id": "Vtg5o1rgeUof"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "fig, axes = plt.subplots(2, 2, figsize=(13, 10))\n",
        "for column, variant in enumerate([\"All\", \"GA\"]):\n",
        "    for name in model_names:\n",
        "        probs = test_probs[(name, variant)]\n",
        "\n",
        "        precision, recall, _ = precision_recall_curve(y_test, probs)\n",
        "        axes[0, column].plot(recall, precision, color=model_colors[name],\n",
        "                             label=f\"{name} ({average_precision_score(y_test, probs):.3f})\")\n",
        "\n",
        "        observed, predicted = calibration_curve(y_test, probs, n_bins=10, strategy=\"quantile\")\n",
        "        axes[1, column].plot(predicted, observed, marker=\"o\", color=model_colors[name], label=name)\n",
        "\n",
        "    axes[0, column].axhline(y_test.mean(), color=\"black\", linestyle=\":\")\n",
        "    axes[0, column].set(title=f\"Precision-recall ({variant} features)\", xlabel=\"Recall\", ylabel=\"Precision\")\n",
        "    axes[0, column].legend(fontsize=8)\n",
        "\n",
        "    axes[1, column].plot([0, 1], [0, 1], \"k--\")\n",
        "    axes[1, column].set(title=f\"Calibration ({variant} features)\",\n",
        "                        xlabel=\"Mean predicted probability\", ylabel=\"Observed fraud rate\")\n",
        "    axes[1, column].legend(fontsize=8)\n",
        "save_and_show(\"pr_and_calibration.png\")\n",
        "\n",
        "display(results_table[[\"Model\", \"Features\", \"Brier\", \"ECE\"]].pivot(index=\"Model\", columns=\"Features\").round(4))"
      ],
