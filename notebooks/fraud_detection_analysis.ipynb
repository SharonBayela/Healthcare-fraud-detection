    {
      "cell_type": "markdown",
      "source": [
        "# Uncertainty, Bayesian coefficients and detection by fraud scheme"
      ],
      "metadata": {
        "id": "zDB6eOakejjb"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# (a) Bayesian logistic regression: coefficients with 95% credible intervals\n",
        "bayes_model = fitted_models[(\"Bayesian Logistic Regression\", \"All\")]\n",
        "coef_means = bayes_model.weights_[1:]\n",
        "coef_sds = np.sqrt(np.diag(bayes_model.covariance_))[1:]\n",
        "largest = np.argsort(-np.abs(coef_means))[:20][::-1]\n",
        "\n",
        "plt.figure(figsize=(9, 7))\n",
        "plt.errorbar(coef_means[largest], range(len(largest)), xerr=1.96 * coef_sds[largest], fmt=\"o\", capsize=3)\n",
        "plt.yticks(range(len(largest)), feature_names[largest])\n",
        "plt.axvline(0, color=\"black\", linestyle=\"--\")\n",
        "plt.title(\"Bayesian LR: 20 largest coefficients (95% credible interval)\")\n",
        "plt.xlabel(\"Change in log-odds of fraud (features are scaled)\")\n",
        "save_and_show(\"bayesian_coefficients.png\")\n",
        "\n",
        "# (b) Does uncertainty point at the claims the model gets wrong?\n",
        "fig, axes = plt.subplots(1, 3, figsize=(17, 4))\n",
        "for axis, name in zip(axes, [\"Bayesian Logistic Regression\", \"Random Forest\", \"Neural Network (MLP)\"]):\n",
        "    probs = test_probs[(name, \"All\")]\n",
        "    uncertainty = test_uncertainty[(name, \"All\")]\n",
        "    is_wrong = (probs >= thresholds[(name, \"All\")]).astype(int) != y_test\n",
        "    sns.kdeplot(uncertainty[~is_wrong], label=\"Correct\", fill=True, ax=axis, common_norm=False)\n",
        "    if is_wrong.any():\n",
        "        sns.kdeplot(uncertainty[is_wrong], label=\"Wrong\", fill=True, ax=axis, common_norm=False)\n",
        "    axis.set_title(f\"{name}\\nmean uncertainty = {uncertainty.mean():.3f}\", fontsize=10)\n",
        "    axis.set_xlabel(\"Predictive standard deviation\")\n",
        "    axis.legend()\n",
        "save_and_show(\"uncertainty.png\")\n",
        "\n",
        "uncertainty_columns = [\"Model\", \"Features\", \"Mean uncertainty\", \"Uncertainty->error AUC\",\n",
        "                       \"Err rate (top 20% uncertain)\", \"Err rate (rest)\"]\n",
        "display(results_table[results_table[\"Mean uncertainty\"].notna()][uncertainty_columns].round(4))\n",
        "\n",
        "# (c) Share of fraudulent claims caught, per fraud scheme (at each model's chosen threshold)\n",
        "fraud_claims = test_df[test_df[\"is_fraud\"] == 1]\n",
        "recall_by_scheme = {}\n",
        "for (name, variant), probs in test_probs.items():\n",
        "    caught = probs[fraud_claims.index] >= thresholds[(name, variant)]\n",
        "    recall_by_scheme[f\"{name} [{variant}]\"] = pd.Series(caught, index=fraud_claims.index).groupby(fraud_claims[\"fraud_scheme\"]).mean()\n",
        "recall_by_scheme = pd.DataFrame(recall_by_scheme).T\n",
        "\n",
        "display(recall_by_scheme.round(3))\n",
        "print(\"Fraudulent test claims per scheme:\", fraud_claims[\"fraud_scheme\"].value_counts().to_dict())\n",
        "plt.figure(figsize=(11, 5))\n",
        "sns.heatmap(recall_by_scheme, annot=True, fmt=\".2f\", cmap=\"YlGnBu\")\n",
        "plt.title(\"Recall by fraud scheme (test)\")\n",
        "save_and_show(\"recall_by_scheme.png\")"
      ],
