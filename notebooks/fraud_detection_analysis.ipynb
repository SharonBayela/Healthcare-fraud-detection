    {
      "cell_type": "code",
      "source": [
        "repeat_seeds = [1, 2, 3, 4, 5]\n",
        "repeat_rows = []\n",
        "\n",
        "for split_seed in repeat_seeds:\n",
        "    (tr_df, va_df, te_df), _ = split_by_provider(data, provider_is_fraud, random_state=split_seed)\n",
        "\n",
        "    builder = FeatureBuilder().fit(tr_df)\n",
        "    f_tr = builder.transform(tr_df).drop(columns=constant_cols)\n",
        "    f_va = builder.transform(va_df).drop(columns=constant_cols)\n",
        "    f_te = builder.transform(te_df).drop(columns=constant_cols)\n",
        "    for table in (f_tr, f_va, f_te):\n",
        "        for column in category_cols:\n",
        "            table[column] = table[column].astype(str)\n",
        "\n",
        "    prep = ColumnTransformer([\n",
        "        (\"numeric\", Pipeline([(\"fill\", SimpleImputer(strategy=\"median\")), (\"scale\", RobustScaler())]), numeric_cols),\n",
        "        (\"category\", OneHotEncoder(handle_unknown=\"ignore\", min_frequency=0.005, sparse_output=False), category_cols),\n",
        "    ])\n",
        "    xt = prep.fit_transform(f_tr).astype(np.float32)\n",
        "    xv = prep.transform(f_va).astype(np.float32)\n",
        "    xe = prep.transform(f_te).astype(np.float32)\n",
        "    yt, yv, ye = tr_df[\"is_fraud\"].values, va_df[\"is_fraud\"].values, te_df[\"is_fraud\"].values\n",
        "\n",
        "    for name in model_names:\n",
        "        model = full_models[name]().fit(xt, yt)\n",
        "        val_probs, _ = predict_with_uncertainty(model, xv)\n",
        "        threshold = best_f1_threshold(yv, val_probs)\n",
        "        probs, _ = predict_with_uncertainty(model, xe)\n",
        "        predicted = (probs >= threshold).astype(int)\n",
        "        repeat_rows.append({\"split_seed\": split_seed, \"Model\": name,\n",
        "                            \"PR-AUC\": average_precision_score(ye, probs),\n",
        "                            \"ROC-AUC\": roc_auc_score(ye, probs),\n",
        "                            \"Recall\": recall_score(ye, predicted),\n",
        "                            \"Precision\": precision_score(ye, predicted, zero_division=0),\n",
        "                            \"F1\": f1_score(ye, predicted)})\n",
        "    print(f\"split {split_seed} done\")\n",
        "\n",
        "repeat_results = pd.DataFrame(repeat_rows)\n",
        "summary = repeat_results.groupby(\"Model\")[[\"PR-AUC\", \"ROC-AUC\", \"Recall\", \"Precision\", \"F1\"]].agg([\"mean\", \"std\"]).round(3)\n",
        "display(summary)\n",
        "display(repeat_results.pivot(index=\"split_seed\", columns=\"Model\", values=\"PR-AUC\").round(3))\n",
        "\n",
        "plt.figure(figsize=(8, 4.5))\n",
        "sns.boxplot(data=repeat_results, x=\"Model\", y=\"PR-AUC\")\n",
        "plt.xticks(rotation=15)\n",
        "plt.title(\"PR-AUC across 5 different provider splits (all features)\")\n",
        "save_and_show(\"repeated_splits.png\")"
      ],
