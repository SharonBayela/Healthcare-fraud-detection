      "cell_type": "code",
      "source": [
        "# ---------- how each model is built ----------\n",
        "# Logistic regression and random forest use the settings from the paper (its Tables I and II).\n",
        "def build_logistic_regression(max_iter=1000):\n",
        "    return LogisticRegression(penalty=\"l1\", C=0.03, class_weight=\"balanced\", solver=\"liblinear\",\n",
        "                              random_state=paper_random_state, max_iter=max_iter)\n",
        "\n",
        "def build_random_forest(n_trees):\n",
        "    return RandomForestClassifier(n_estimators=n_trees, max_depth=4, class_weight=\"balanced\",\n",
        "                                  n_jobs=-1, random_state=paper_random_state)\n",
        "\n",
        "model_names = [\"Logistic Regression\", \"Random Forest\", \"Bayesian Logistic Regression\", \"Neural Network (MLP)\"]\n",
        "\n",
        "# full versions, used for the final results\n",
        "full_models = {\n",
        "    \"Logistic Regression\": lambda: build_logistic_regression(),\n",
        "    \"Random Forest\": lambda: build_random_forest(rf_trees),\n",
        "    \"Bayesian Logistic Regression\": lambda: BayesianLogisticRegression(prior_sd=1.0, n_samples=200),\n",
        "    \"Neural Network (MLP)\": lambda: MLPEnsemble(n_members=3, max_iter=60),\n",
        "}\n",
        "# lighter versions, used only inside the genetic algorithm to keep it fast\n",
        "light_models = {\n",
        "    \"Logistic Regression\": lambda: build_logistic_regression(300),\n",
        "    \"Random Forest\": lambda: build_random_forest(60),\n",
        "    \"Bayesian Logistic Regression\": lambda: BayesianLogisticRegression(prior_sd=1.0, n_samples=50),\n",
        "    \"Neural Network (MLP)\": lambda: MLPEnsemble(n_members=2, max_iter=40),\n",
        "}\n",
        "\n",
        "\n",
        "# ---------- prediction and evaluation helpers ----------\n",
        "def predict_with_uncertainty(model, x):\n",
        "    \"\"\"Return (fraud probability, uncertainty) for any of the four models.\n",
        "\n",
        "    Bayesian LR: spread of the posterior predictions.\n",
        "    Random forest: spread across the individual trees.\n",
        "    Neural network ensemble: spread across the ensemble members.\n",
        "    Plain logistic regression has no uncertainty, so NaN is returned for it.\n",
        "    \"\"\"\n",
        "    if isinstance(model, BayesianLogisticRegression):\n",
        "        return model.predict_with_spread(x)\n",
        "    if isinstance(model, RandomForestClassifier):\n",
        "        x32 = np.asarray(x, dtype=np.float32)\n",
        "        tree_probs = np.stack([tree.predict_proba(x32)[:, 1] for tree in model.estimators_])\n",
        "        return tree_probs.mean(axis=0), tree_probs.std(axis=0)\n",
        "    if isinstance(model, MLPEnsemble):\n",
        "        member_probs = model.member_probabilities(x)\n",
        "        return member_probs.mean(axis=0), member_probs.std(axis=0)\n",
        "    probs = model.predict_proba(x)[:, 1]\n",
        "    return probs, np.full(len(probs), np.nan)\n",
        "\n",
        "\n",
        "def expected_calibration_error(y_true, probs, n_bins=10):\n",
        "    \"\"\"Average gap between predicted probability and actual fraud rate, over equal-width bins.\"\"\"\n",
        "    bin_edges = np.linspace(0, 1, n_bins + 1)[1:-1]\n",
        "    bin_number = np.digitize(probs, bin_edges)\n",
        "    total_error = 0.0\n",
        "    for b in range(n_bins):\n",
        "        in_bin = bin_number == b\n",
        "        if in_bin.any():\n",
        "            gap = abs(y_true[in_bin].mean() - probs[in_bin].mean())\n",
        "            total_error += gap * in_bin.sum() / len(y_true)\n",
        "    return total_error\n",
        "\n",
        "\n",
        "def best_f1_threshold(y_true, probs):\n",
        "    \"\"\"Probability cut-off that gives the highest F1 score. Only call this on validation data.\"\"\"\n",
        "    precision, recall, thresholds = precision_recall_curve(y_true, probs)\n",
        "    f1_scores = 2 * precision * recall / (precision + recall + 1e-12)\n",
        "    return thresholds[np.argmax(f1_scores[:-1])]\n",
        "\n",
        "\n",
        "def evaluate_predictions(y_true, probs, uncertainty, threshold):\n",
        "    \"\"\"Compute the evaluation metrics, plus uncertainty diagnostics when uncertainty is available.\"\"\"\n",
        "    predicted = (probs >= threshold).astype(int)\n",
        "    scores = {\n",
        "        \"PR-AUC\": average_precision_score(y_true, probs),\n",
        "        \"ROC-AUC\": roc_auc_score(y_true, probs),\n",
        "        \"F1\": f1_score(y_true, predicted),\n",
        "        \"Recall\": recall_score(y_true, predicted),\n",
        "        \"Precision\": precision_score(y_true, predicted, zero_division=0),\n",
        "        \"Brier\": brier_score_loss(y_true, probs),\n",
        "        \"ECE\": expected_calibration_error(y_true, probs),\n",
        "        \"Threshold\": threshold,\n",
        "    }\n",
        "    if not np.isnan(uncertainty).any():\n",
        "        is_error = (predicted != y_true).astype(int)\n",
        "        most_uncertain = uncertainty >= np.quantile(uncertainty, 0.8)\n",
        "        scores[\"Mean uncertainty\"] = uncertainty.mean()\n",
        "        scores[\"Uncertainty->error AUC\"] = (roc_auc_score(is_error, uncertainty)\n",
        "                                            if is_error.min() != is_error.max() else np.nan)\n",
        "        scores[\"Err rate (top 20% uncertain)\"] = is_error[most_uncertain].mean()\n",
        "        scores[\"Err rate (rest)\"] = is_error[~most_uncertain].mean()\n",
        "    return scores\n",
        "\n",
        "\n",
        "# Everything fitted so far is stored here, keyed by (model name, \"All\" or \"GA\").\n",
        "fitted_models, test_probs, test_uncertainty, thresholds = {}, {}, {}, {}\n",
        "\n",
        "def fit_and_evaluate(model_name, variant, feature_columns):\n",
        "    \"\"\"Train one model on the chosen feature columns, pick its threshold on the validation set,\n",
        "    score it on the test set and keep everything for later stages.\n",
        "    Uses x_train, x_val, x_test and the y arrays from the earlier cells.\"\"\"\n",
        "    start_time = time.time()\n",
        "    model = full_models[model_name]().fit(x_train[:, feature_columns], y_train)\n",
        "\n",
        "    val_probs, _ = predict_with_uncertainty(model, x_val[:, feature_columns])\n",
        "    threshold = best_f1_threshold(y_val, val_probs)\n",
        "    probs, uncertainty = predict_with_uncertainty(model, x_test[:, feature_columns])\n",
        "\n",
        "    scores = evaluate_predictions(y_test, probs, uncertainty, threshold)\n",
        "    scores.update({\"Model\": model_name, \"Features\": variant,\n",
        "                   \"n_features\": len(feature_columns),\n",
        "                   \"Seconds\": round(time.time() - start_time, 1)})\n",
        "\n",
        "    key = (model_name, variant)\n",
        "    fitted_models[key], test_probs[key] = model, probs\n",
        "    test_uncertainty[key], thresholds[key] = uncertainty, threshold\n",
        "    return scores\n",
        "\n",
        "\n",
        "model_colors = dict(zip(model_names, sns.color_palette(\"tab10\", 4)))\n",
        "print(\"Models ready:\", model_names)\n",
        "print(\"Note: class_weight='balanced' (from the paper) shifts the probabilities, so calibration of the\")\n",
        "print(\"logistic regression and random forest will look worse. Ranking metrics like PR-AUC are not affected.\")"
      ],
