      "cell_type": "markdown",
      "source": [
        "# Is the paper’s main finding (“reimbursed amount matters most”) true here?"
      ],
      "metadata": {
        "id": "1-zK9EJperTi"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def rank_features(model_name, variant=\"All\"):\n",
        "    \"\"\"Rank features for a fitted model: by absolute coefficient for the logistic models,\n",
        "    by impurity importance for the random forest.\"\"\"\n",
        "    model = fitted_models[(model_name, variant)]\n",
        "    if isinstance(model, LogisticRegression):\n",
        "        strength = np.abs(model.coef_[0])\n",
        "    elif isinstance(model, BayesianLogisticRegression):\n",
        "        strength = np.abs(model.weights_[1:])\n",
        "    else:\n",
        "        strength = model.feature_importances_\n",
        "    return pd.Series(strength, index=feature_names).sort_values(ascending=False)\n",
        "\n",
        "\n",
        "def is_billing_feature(feature_name):\n",
        "    return \"billed\" in feature_name or feature_name.startswith(\"peer_\")\n",
        "\n",
        "\n",
        "fig, axes = plt.subplots(1, 3, figsize=(19, 5))\n",
        "for axis, name in zip(axes, [\"Logistic Regression\", \"Bayesian Logistic Regression\", \"Random Forest\"]):\n",
        "    ranking = rank_features(name)\n",
        "    top_ten = ranking.head(10)[::-1]\n",
        "    bar_colors = [\"#C44E52\" if is_billing_feature(f) else \"#4C72B0\" for f in top_ten.index]\n",
        "    top_ten.plot.barh(ax=axis, color=bar_colors)\n",
        "    axis.set_title(f\"{name}\\n(red = billing-related)\", fontsize=10)\n",
        "\n",
        "    billing_positions = [i + 1 for i, f in enumerate(ranking.index) if is_billing_feature(f)]\n",
        "    best_billing_rank = billing_positions[0] if billing_positions else None\n",
        "    print(f\"{name}: top 5 = {list(ranking.index[:5])} | best billing feature ranks #{best_billing_rank}\")\n",
        "save_and_show(\"feature_importance.png\")\n",
        "\n",
        "# Is the billing signal really about unusual billing, or just about bigger providers?\n",
        "provider_view = pd.DataFrame({\n",
        "    \"total_billed\": features_test[\"provider_total_billed\"].groupby(test_df[\"provider_id\"].values).first(),\n",
        "    \"n_claims\": features_test[\"provider_n_claims\"].groupby(test_df[\"provider_id\"].values).first(),\n",
        "    \"mean_billed\": features_test[\"provider_mean_billed\"].groupby(test_df[\"provider_id\"].values).first(),\n",
        "    \"mean_peer_z\": features_test[\"provider_mean_peer_z\"].groupby(test_df[\"provider_id\"].values).first(),\n",
        "    \"fraud\": test_df.groupby(\"provider_id\")[\"is_fraud\"].max(),\n",
        "})\n",
        "print(\"\\nCorrelation with provider-level fraud (test providers):\")\n",
        "display(provider_view.corr()[\"fraud\"].drop(\"fraud\").to_frame(\"correlation\").round(3))\n",
        "print(\"If total billed correlates with fraud mainly because it tracks number of claims, then the paper's \"\n",
        "      \"'reimbursed amount' finding may partly reflect provider size. Compare it with mean_billed and mean_peer_z.\")"
      ],
