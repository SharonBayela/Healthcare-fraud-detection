    {
      "cell_type": "code",
      "source": [
        "columns_to_sum = [c for c in [\"billed_amount\", \"severity\", \"is_duplicate\", \"same_visit_count\",\n",
        "                              \"count_provider_patient\", \"billed_after_death\", \"n_chronic\", \"age\",\n",
        "                              \"count_provider_patient_procedure\", \"count_provider_patient_diagnosis\"]\n",
        "                  if c in features_train.columns]\n",
        "\n",
        "\n",
        "def build_provider_table(features, claims_df):\n",
        "    \"\"\"Collapse claim-level features into one row per provider, like the paper's aggregation step:\n",
        "    sums of the claim features, number of claims and patients, and number of unique codes.\"\"\"\n",
        "    to_sum = features[columns_to_sum].copy()\n",
        "    to_sum[\"provider_id\"] = claims_df[\"provider_id\"].values\n",
        "    grouped = to_sum.groupby(\"provider_id\")\n",
        "\n",
        "    table = grouped[columns_to_sum].sum().add_prefix(\"sum_\")\n",
        "    table[\"n_claims\"] = grouped.size()\n",
        "    table[\"n_patients\"] = claims_df.groupby(\"provider_id\")[\"patient_id\"].nunique()\n",
        "    table[\"n_unique_procedures\"] = claims_df.groupby(\"provider_id\")[\"procedure_category\"].nunique()\n",
        "    table[\"n_unique_diagnoses\"] = claims_df.groupby(\"provider_id\")[\"diagnosis_group\"].nunique()\n",
        "    return table\n",
        "\n",
        "\n",
        "def paper_style_metrics(y_true, probs, threshold=0.5):\n",
        "    \"\"\"Metrics the way the paper reports them (accuracy and weighted precision/recall/F1),\n",
        "    next to the fraud-class metrics that show how well fraud itself is caught.\n",
        "\n",
        "    The paper's ROC curves have a single corner, which suggests it computed AUC from hard 0/1\n",
        "    predictions. Both versions of AUC are shown here.\n",
        "    \"\"\"\n",
        "    predicted = (probs >= threshold).astype(int)\n",
        "    return {\n",
        "        \"Accuracy\": accuracy_score(y_true, predicted),\n",
        "        \"Precision (weighted)\": precision_score(y_true, predicted, average=\"weighted\", zero_division=0),\n",
        "        \"Recall (weighted)\": recall_score(y_true, predicted, average=\"weighted\"),\n",
        "        \"F1 (weighted)\": f1_score(y_true, predicted, average=\"weighted\"),\n",
        "        \"AUC (from probabilities)\": roc_auc_score(y_true, probs),\n",
        "        \"AUC (from hard labels, paper-style)\": roc_auc_score(y_true, predicted),\n",
        "        \"Fraud precision\": precision_score(y_true, predicted, zero_division=0),\n",
        "        \"Fraud recall\": recall_score(y_true, predicted),\n",
        "        \"Fraud F1\": f1_score(y_true, predicted),\n",
        "        \"PR-AUC (fraud)\": average_precision_score(y_true, probs),\n",
        "    }\n",
        "\n",
        "\n",
        "# The paper used a plain 80/20 split, so train on train + validation providers and test on the same test providers.\n",
        "train_val_df = pd.concat([train_df, val_df], ignore_index=True)\n",
        "features_train_val = pd.concat([features_train, features_val], ignore_index=True)\n",
        "\n",
        "provider_train = build_provider_table(features_train_val, train_val_df)\n",
        "provider_test = build_provider_table(features_test, test_df)\n",
        "provider_y_train = provider_is_fraud.reindex(provider_train.index).values\n",
        "provider_y_test = provider_is_fraud.reindex(provider_test.index).values\n",
        "print(f\"Provider tables: train {provider_train.shape}, test {provider_test.shape}\")\n",
        "print(f\"Fraudulent providers: train {provider_y_train.sum()}, test {provider_y_test.sum()}\")\n",
        "if provider_y_test.sum() < 10:\n",
        "    print(\"Warning: very few fraudulent test providers, so treat these numbers as indicative only.\")\n",
        "\n",
        "provider_scaler = RobustScaler().fit(provider_train.fillna(0))\n",
        "provider_x_train = provider_scaler.transform(provider_train.fillna(0))\n",
        "provider_x_test = provider_scaler.transform(provider_test.fillna(0))\n",
        "\n",
        "paper_models = {\"Logistic Regression (paper settings)\": build_logistic_regression(),\n",
        "                \"Random Forest (paper settings)\": build_random_forest(500)}\n",
        "paper_rows, paper_confusions, paper_lr_model = [], {}, None\n",
        "for name, model in paper_models.items():\n",
        "    model.fit(provider_x_train, provider_y_train)\n",
        "    probs = model.predict_proba(provider_x_test)[:, 1]\n",
        "    paper_rows.append({\"Model\": name, **paper_style_metrics(provider_y_test, probs)})\n",
        "    paper_confusions[name] = confusion_matrix(provider_y_test, (probs >= 0.5).astype(int))\n",
        "    if name.startswith(\"Logistic\"):\n",
        "        paper_lr_model = model\n",
        "\n",
        "replication = pd.DataFrame(paper_rows).set_index(\"Model\")\n",
        "print(\"\\nResults on this dataset (test providers):\")\n",
        "display(replication.round(3))\n",
        "\n",
        "paper_reported = pd.DataFrame(\n",
        "    {\"Accuracy\": [0.87, 0.90], \"Precision (weighted)\": [0.93, 0.93], \"Recall (weighted)\": [0.87, 0.91],\n",
        "     \"F1 (weighted)\": [0.89, 0.90], \"AUC\": [0.86, 0.85]},\n",
        "    index=[\"Random Forest (paper, Kaggle data)\", \"Logistic Regression (paper, Kaggle data)\"])\n",
        "print(\"What the paper reported in its Table III (Kaggle data), for comparison:\")\n",
        "display(paper_reported)\n",
        "\n",
        "fig, axes = plt.subplots(1, 3, figsize=(17, 4.5))\n",
