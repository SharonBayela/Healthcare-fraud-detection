        "# Load the three tables from the csv files in the Hugging Face repo.\n",
        "from huggingface_hub import HfApi\n",
        "\n",
        "all_files = HfApi().list_repo_files(repo_id, repo_type=\"dataset\")\n",
        "csv_files = [f for f in all_files if f.lower().endswith(\".csv\")]\n",
        "print(\"csv files found in the repo:\", csv_files)\n",
        "\n",
        "tables = {}\n",
        "for table_name in [\"claims\", \"patients\", \"providers\"]:\n",
        "    matches = [f for f in csv_files if table_name in f.lower()]\n",
        "    assert matches, f\"No csv file containing '{table_name}' was found. Files in the repo: {all_files}\"\n",
        "    print(f\"Reading {table_name} from: {matches[0]}\")\n",
        "    tables[table_name] = pd.read_csv(f\"hf://datasets/{repo_id}/{matches[0]}\")\n",
        "\n",
        "claims = tables[\"claims\"]\n",
        "patients = tables[\"patients\"]\n",
        "providers = tables[\"providers\"]\n",
        "\n",
        "# Look at each table\n",
        "for table_name, table in tables.items():\n",
        "    print(f\"\\n=== {table_name}: {table.shape} ===\")\n",
        "    display(table.head(3))\n",
        "    print(table.dtypes.to_string())\n",
        "\n",
        "print(\"\\nProvider table columns:\", list(providers.columns))\n",
        "print(\"Share of fraudulent claims: %.4f\" % claims[\"is_fraud\"].mean())"
