        "    axis.set_title(name, fontsize=10)\n",
        "replication[[\"Accuracy\", \"F1 (weighted)\", \"Fraud precision\", \"Fraud recall\", \"PR-AUC (fraud)\"]].T.plot.bar(ax=axes[2], rot=15)\n",
        "axes[2].set_title(\"Weighted metrics vs fraud-class metrics\")\n",
        "axes[2].set_ylim(0, 1.05)\n",
        "axes[2].legend(fontsize=7)\n",
        "save_and_show(\"paper_replication.png\")\n",
