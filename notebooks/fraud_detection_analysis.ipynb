        "coefficients = pd.Series(paper_lr_model.coef_[0], index=provider_train.columns)\n",
        "top_five = coefficients.reindex(coefficients.abs().sort_values(ascending=False).index).head(5)\n",
        "print(\"\\nFive largest logistic regression coefficients (like the paper's Fig. 16):\")\n",
        "display(top_five.to_frame(\"coefficient\"))\n",
        "print(\"Non-zero coefficients:\", int((coefficients != 0).sum()), \"out of\", len(coefficients))"
