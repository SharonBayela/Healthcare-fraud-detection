    {
      "cell_type": "code",
      "source": [
        "results_ga = pd.DataFrame([fit_and_evaluate(name, \"GA\", np.where(ga_masks[name])[0]) for name in model_names])\n",
        "results_table = pd.concat([results_all, results_ga], ignore_index=True)\n",
        "results_table.to_csv(os.path.join(figure_dir, \"results_table.csv\"), index=False)\n",
        "display(results_ga[result_columns].round(4))\n",
        "\n",
        "metrics_to_compare = [\"PR-AUC\", \"ROC-AUC\", \"F1\", \"Recall\", \"Brier\", \"ECE\"]\n",
        "change_with_ga = (results_ga.set_index(\"Model\")[metrics_to_compare]\n",
        "                  - results_all.set_index(\"Model\")[metrics_to_compare])\n",
        "change_with_ga[\"features_removed\"] = n_features - results_ga.set_index(\"Model\")[\"n_features\"]\n",
        "print(\"\\nChange when using GA-selected features (GA minus All). For Brier and ECE, lower is better:\")\n",
        "display(change_with_ga.round(4))\n",
        "\n",
        "fig, axes = plt.subplots(1, 3, figsize=(17, 4.5))\n",
        "for axis, metric in zip(axes, [\"PR-AUC\", \"F1\", \"Recall\"]):\n",
        "    table = results_table.pivot(index=\"Model\", columns=\"Features\", values=metric).loc[model_names]\n",
        "    table.plot.bar(ax=axis, rot=15)\n",
        "    axis.set_title(f\"{metric}: all features vs GA features (test)\")\n",
        "    axis.set_ylim(0, 1.05)\n",
        "save_and_show(\"all_vs_ga.png\")"
      ],
