      "cell_type": "markdown",
      "source": [
        "# Statistical comparison (provider-level bootstrap of PR-AUC)"
      ],
      "metadata": {
        "id": "xFdYLlc3ecrE"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def bootstrap_pr_auc(probs_by_model, y_true, provider_ids, n_rounds=n_bootstrap):\n",
        "    \"\"\"Bootstrap PR-AUC for every model on the same resamples of PROVIDERS.\n",
        "\n",
        "    Each round draws providers with replacement (taking all of their claims), so claims from the same\n",
        "    provider stay together. Using the same resample for all models makes the comparison paired.\n",
        "    Returns a dict: model key -> array of PR-AUC values.\n",
        "    \"\"\"\n",
        "    claim_positions = pd.Series(np.arange(len(provider_ids))).groupby(provider_ids).indices\n",
        "    unique_providers = np.array(list(claim_positions.keys()))\n",
        "    generator = np.random.default_rng(seed)\n",
        "    scores = {key: [] for key in probs_by_model}\n",
        "\n",
        "    for _ in range(n_rounds):\n",
        "        drawn = generator.choice(unique_providers, len(unique_providers), replace=True)\n",
        "        rows = np.concatenate([claim_positions[provider] for provider in drawn])\n",
        "        if y_true[rows].min() == y_true[rows].max():\n",
        "            continue\n",
        "        for key, probs in probs_by_model.items():\n",
        "            scores[key].append(average_precision_score(y_true[rows], probs[rows]))\n",
        "\n",
        "    return {key: np.array(values) for key, values in scores.items()}\n",
        "\n",
        "\n",
        "def compare_two_models(boot_scores, key_a, key_b):\n",
        "    \"\"\"Difference in PR-AUC (A minus B): mean, 95% interval and a two-sided bootstrap p-value.\"\"\"\n",
        "    difference = boot_scores[key_a] - boot_scores[key_b]\n",
        "    low, high = np.percentile(difference, [2.5, 97.5])\n",
        "    p_value = min(1.0, 2 * min((difference <= 0).mean(), (difference >= 0).mean()))\n",
        "    return {\"A\": f\"{key_a[0]} [{key_a[1]}]\", \"B\": f\"{key_b[0]} [{key_b[1]}]\",\n",
        "            \"dPR-AUC (A-B)\": difference.mean(), \"CI low\": low, \"CI high\": high,\n",
        "            \"p (bootstrap)\": p_value, \"CI excludes 0\": bool(low > 0 or high < 0)}\n",
        "\n",
        "\n",
        "boot_scores = bootstrap_pr_auc(test_probs, y_test, test_df[\"provider_id\"].values)\n",
        "\n",
        "pairs_to_compare = []\n",
        "for name in model_names:                                            # does GA help each model?\n",
        "    pairs_to_compare.append(((name, \"GA\"), (name, \"All\")))\n",
        "for variant in [\"All\", \"GA\"]:                                       # model against model\n",
        "    for other in [\"Logistic Regression\", \"Random Forest\", \"Neural Network (MLP)\"]:\n",
        "        pairs_to_compare.append(((\"Bayesian Logistic Regression\", variant), (other, variant)))\n",
        "    pairs_to_compare.append(((\"Neural Network (MLP)\", variant), (\"Random Forest\", variant)))\n",
        "    pairs_to_compare.append(((\"Neural Network (MLP)\", variant), (\"Logistic Regression\", variant)))\n",
        "\n",
        "comparison_table = pd.DataFrame([compare_two_models(boot_scores, a, b) for a, b in pairs_to_compare])\n",
        "\n",
        "n_valid_rounds = len(next(iter(boot_scores.values())))\n",
        "comparison_table[\"p (bootstrap)\"] = comparison_table[\"p (bootstrap)\"].clip(lower=1 / (n_valid_rounds + 1))\n",
        "\n",
        "# Holm correction for running several comparisons at once\n",
        "p_values = comparison_table[\"p (bootstrap)\"].values\n",
        "order = np.argsort(p_values)\n",
        "adjusted = np.empty(len(p_values))\n",
        "running_max = 0.0\n",
        "for rank, index in enumerate(order):\n",
        "    running_max = max(running_max, (len(p_values) - rank) * p_values[index])\n",
        "    adjusted[index] = min(1.0, running_max)\n",
        "comparison_table[\"p (Holm-adjusted)\"] = adjusted\n",
        "comparison_table[\"Significant after correction\"] = adjusted < 0.05\n",
        "comparison_table.to_csv(os.path.join(figure_dir, \"statistical_comparison.csv\"), index=False)\n",
        "print(f\"Valid bootstrap rounds: {len(next(iter(boot_scores.values())))}\")\n",
        "display(comparison_table.round(4))\n",
        "\n",
        "fig, axis = plt.subplots(figsize=(10, 5))\n",
        "bar_width = 0.38\n",
        "for offset, variant in enumerate([\"All\", \"GA\"]):\n",
        "    means = np.array([boot_scores[(name, variant)].mean() for name in model_names])\n",
        "    lows = np.array([np.percentile(boot_scores[(name, variant)], 2.5) for name in model_names])\n",
        "    highs = np.array([np.percentile(boot_scores[(name, variant)], 97.5) for name in model_names])\n",
        "    axis.bar(np.arange(4) + (offset - 0.5) * bar_width, means, bar_width,\n",
        "             yerr=[means - lows, highs - means], capsize=4, label=f\"{variant} features\")\n",
        "axis.set_xticks(range(4))\n",
        "axis.set_xticklabels([n.replace(\" \", \"\\n\", 1) for n in model_names])\n",
        "axis.set(ylabel=\"PR-AUC (test, 95% bootstrap interval)\", title=\"PR-AUC with confidence intervals\")\n",
        "axis.legend()\n",
        "save_and_show(\"bootstrap.png\")"
      ],
