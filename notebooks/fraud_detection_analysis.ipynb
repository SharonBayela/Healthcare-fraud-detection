      "cell_type": "markdown",
      "source": [
        "# Models and evaluation helpers"
      ],
      "metadata": {
        "id": "SESrOyFMfZU1"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "class BayesianLogisticRegression(BaseEstimator, ClassifierMixin):\n",
        "    \"\"\"Logistic regression with a Bayesian treatment of the weights.\n",
        "\n",
        "    Every weight gets a normal prior with mean 0 and standard deviation `prior_sd` (a very wide prior\n",
        "    on the intercept). The posterior is approximated with a normal distribution (Laplace approximation):\n",
        "    it is centred on the most likely weights and its spread comes from the curvature at that point.\n",
        "\n",
        "    predict_proba averages the predictions over many weight samples drawn from the posterior.\n",
        "    predict_with_spread also returns the standard deviation of those predictions, which is the\n",
        "    uncertainty for each claim.\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self, prior_sd=1.0, n_samples=200, random_state=seed):\n",
        "        self.prior_sd = prior_sd\n",
        "        self.n_samples = n_samples\n",
        "        self.random_state = random_state\n",
        "\n",
        "    def add_intercept(self, x):\n",
        "        return np.hstack([np.ones((len(x), 1)), x])\n",
        "\n",
        "    def fit(self, x, y):\n",
        "        x = self.add_intercept(np.asarray(x, dtype=float))\n",
        "        y = np.asarray(y, dtype=float)\n",
        "        n_weights = x.shape[1]\n",
        "\n",
        "        prior_precision = np.full(n_weights, 1.0 / self.prior_sd ** 2)\n",
        "        prior_precision[0] = 1.0 / 100.0           # intercept: very wide prior\n",
        "\n",
        "        def negative_log_posterior(weights):\n",
        "            scores = x @ weights\n",
        "            data_term = np.sum(np.logaddexp(0, scores) - y * scores)\n",
        "            prior_term = 0.5 * np.sum(prior_precision * weights * weights)\n",
        "            return data_term + prior_term\n",
        "\n",
        "        def gradient(weights):\n",
        "            return x.T @ (expit(x @ weights) - y) + prior_precision * weights\n",
        "\n",
        "        best = minimize(negative_log_posterior, np.zeros(n_weights), jac=gradient,\n",
        "                        method=\"L-BFGS-B\", options={\"maxiter\": 300})\n",
        "        weights_map = best.x\n",
        "\n",
        "        probabilities = expit(x @ weights_map)\n",
        "        curvature = (x * (probabilities * (1 - probabilities))[:, None]).T @ x + np.diag(prior_precision)\n",
        "\n",
        "        self.weights_ = weights_map\n",
        "        self.covariance_ = np.linalg.inv(curvature)\n",
        "        self.classes_ = np.array([0, 1])\n",
        "        return self\n",
        "\n",
        "    def predict_with_spread(self, x, chunk_size=20000):\n",
        "        \"\"\"Return (mean predicted fraud probability, standard deviation) for each row.\"\"\"\n",
        "        x = np.asarray(x, dtype=float)\n",
        "        generator = np.random.default_rng(self.random_state)\n",
        "        weight_samples = generator.multivariate_normal(self.weights_, self.covariance_, size=self.n_samples)\n",
        "\n",
        "        means, spreads = [], []\n",
        "        for start in range(0, len(x), chunk_size):\n",
        "            chunk = self.add_intercept(x[start:start + chunk_size])\n",
        "            sampled_probs = expit(chunk @ weight_samples.T)\n",
        "            means.append(sampled_probs.mean(axis=1))\n",
        "            spreads.append(sampled_probs.std(axis=1))\n",
        "        return np.concatenate(means), np.concatenate(spreads)\n",
        "\n",
        "    def predict_proba(self, x):\n",
        "        mean_prob, _ = self.predict_with_spread(x)\n",
        "        return np.column_stack([1 - mean_prob, mean_prob])\n",
        "\n",
        "    def predict(self, x):\n",
        "        return (self.predict_proba(x)[:, 1] >= 0.5).astype(int)\n",
        "\n",
        "\n",
        "class MLPEnsemble(BaseEstimator, ClassifierMixin):\n",
        "    \"\"\"Several small neural networks trained from different random starts.\n",
        "    The average of their predictions is the fraud probability and the disagreement\n",
        "    between them (standard deviation) is the uncertainty.\"\"\"\n",
        "\n",
        "    def __init__(self, n_members=3, hidden_layers=(64, 32), alpha=1e-3, max_iter=60, random_state=seed):\n",
        "        self.n_members = n_members\n",
        "        self.hidden_layers = hidden_layers\n",
        "        self.alpha = alpha\n",
        "        self.max_iter = max_iter\n",
        "        self.random_state = random_state\n",
        "\n",
        "    def fit(self, x, y):\n",
        "        self.members_ = []\n",
        "        for member_number in range(self.n_members):\n",
        "            network = MLPClassifier(hidden_layer_sizes=self.hidden_layers, alpha=self.alpha,\n",
        "                                    early_stopping=True, n_iter_no_change=5,\n",
        "                                    max_iter=self.max_iter,\n",
        "                                    random_state=self.random_state + member_number)\n",
        "            self.members_.append(network.fit(x, y))\n",
        "        self.classes_ = np.array([0, 1])\n",
        "        return self\n",
        "\n",
        "    def member_probabilities(self, x):\n",
        "        return np.stack([member.predict_proba(x)[:, 1] for member in self.members_])\n",
        "\n",
        "    def predict_proba(self, x):\n",
        "        mean_prob = self.member_probabilities(x).mean(axis=0)\n",
        "        return np.column_stack([1 - mean_prob, mean_prob])\n",
        "\n",
        "    def predict(self, x):\n",
        "        return (self.predict_proba(x)[:, 1] >= 0.5).astype(int)\n"
